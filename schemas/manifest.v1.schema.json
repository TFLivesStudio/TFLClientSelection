{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tfl:selection:manifest:v1",
  "title": "TFL Selection immutable pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "targetId",
    "release",
    "channel",
    "status",
    "minecraft",
    "features",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "const": "tfl-selection"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "dev"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumLauncherVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "loader",
        "javaMajor"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "loader": {
          "enum": [
            "ornithe-gen2",
            "fabric",
            "neoforge",
            "forge",
            "quilt"
          ]
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "javaMajor": {
          "type": "integer",
          "minimum": 8,
          "maximum": 30
        }
      }
    },
    "features": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "defaultEnabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "defaultEnabled": {
            "type": "boolean"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "publishedAt"
        ],
        "properties": {
          "files": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "bytes",
        "installPolicy",
        "delivery",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
        },
        "kind": {
          "enum": [
            "mod",
            "config",
            "resourcepack",
            "shaderpack",
            "asset",
            "datapack"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "installPolicy": {
          "enum": [
            "managed",
            "seed-if-absent"
          ]
        },
        "featureId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,39}$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x64",
              "arm64"
            ]
          }
        },
        "delivery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "objectKey"
              ],
              "properties": {
                "mode": {
                  "const": "private-object"
                },
                "objectKey": {
                  "type": "string",
                  "pattern": "^sha256/[a-f0-9]{2}/[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "url"
              ],
              "properties": {
                "mode": {
                  "const": "upstream"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          ]
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "homepage",
            "license",
            "redistribution"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "homepage": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "redistribution": {
              "enum": [
                "owned",
                "authorized",
                "upstream-only"
              ]
            },
            "evidenceUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
