{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tfl:selection:catalog:v1",
  "title": "TFL Selection channel catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "const": "tfl-selection"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "minecraftVersion",
          "loader",
          "channels"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$"
          },
          "minecraftVersion": {
            "type": "string",
            "minLength": 1
          },
          "loader": {
            "enum": [
              "ornithe-gen2",
              "fabric",
              "neoforge",
              "forge",
              "quilt"
            ]
          },
          "channels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stable": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release",
                  "manifestPath",
                  "manifestSha256"
                ],
                "properties": {
                  "release": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "manifestPath": {
                    "type": "string",
                    "pattern": "^releases/[a-z0-9.-]+/[a-z0-9.-]+/[a-zA-Z0-9._-]+\\.json$"
                  },
                  "manifestSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "beta": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release",
                  "manifestPath",
                  "manifestSha256"
                ],
                "properties": {
                  "release": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "manifestPath": {
                    "type": "string",
                    "pattern": "^releases/[a-z0-9.-]+/[a-z0-9.-]+/[a-zA-Z0-9._-]+\\.json$"
                  },
                  "manifestSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "dev": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release",
                  "manifestPath",
                  "manifestSha256"
                ],
                "properties": {
                  "release": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "manifestPath": {
                    "type": "string",
                    "pattern": "^releases/[a-z0-9.-]+/[a-z0-9.-]+/[a-zA-Z0-9._-]+\\.json$"
                  },
                  "manifestSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
